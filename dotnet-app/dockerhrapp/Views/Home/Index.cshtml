@{
    ViewData["Title"] = "HR System Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>HR Management System</h2>
        <span class="badge bg-success fs-6">Container: Healthy 🟢</span>
    </div>

    <!-- System Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Employees</h5>
                    <h2 class="display-6 fw-bold">124</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-dark text-white">
                <div class="card-body">
                    <h5 class="card-title">Environment</h5>
                    <h2 class="display-6 fw-bold">Docker / .NET 10</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">Server Host</h5>
                    <p class="card-text">@Environment.MachineName</p>
                </div>
            </div>
        </div>
    </div>
</div>
